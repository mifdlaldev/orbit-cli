{
  "name": "@mifdlaldev/orbit-cli",
  "version": "0.1.0",
  "description": "Universal project generator CLI for Next.js, Nuxt, Astro, SvelteKit, Vue, Remix and Laravel",
  "type": "module",
  "engines": {
    "node": ">=18.20.0"
  },
  "bin": {
    "orbit": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mifdlaldev/orbit-cli.git"
  },
  "bugs": {
    "url": "https://github.com/mifdlaldev/orbit-cli/issues"
  },
  "homepage": "https://github.com/mifdlaldev/orbit-cli#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "project-generator",
    "scaffold",
    "nextjs",
    "nuxt",
    "astro",
    "sveltekit",
    "vue",
    "remix",
    "laravel"
  ],
  "author": "mifdlaldev",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "figlet": "^1.9.4",
    "gradient-string": "^3.0.0",
    "ora": "^9.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.19.3",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.16"
  }
}
