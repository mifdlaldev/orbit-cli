---
import { site } from '../data/site';

const cloneCommand = `${site.repoUrl}.git`;

const steps: readonly { title: string; body: string; code: string }[] = [
  {
    title: 'Clone the repository',
    body: 'ORBIT CLI is not published to npm yet — install from source.',
    code: `git clone ${cloneCommand}`,
  },
  {
    title: 'Install dependencies',
    body: 'A single, reproducible install of the 222 production and dev packages.',
    code: 'cd orbit-cli && npm ci',
  },
  {
    title: 'Build the CLI',
    body: 'Compiles the TypeScript sources into a single ESM bundle in dist/.',
    code: 'npm run build',
  },
  {
    title: 'Run a verified command',
    body: 'doctor probes 8 tools and exits 0 on the reference machine.',
    code: 'node dist/index.js doctor',
  },
];
---

<section id="quickstart" class="border-t border-border">
  <div class="wrap py-20 md:py-28">
    <div class="max-w-[65ch]">
      <p class="eyebrow">quickstart</p>
      <h2 class="text-h2 mt-3 font-bold text-text">Up and running in four steps</h2>
      <p class="mt-4 text-muted">
        Install from source. Nothing is published to the npm registry yet, and
        <span class="font-mono text-text"> npm install -g orbit-cli</span> would install an
        unrelated package that owns that name — so the steps below are the only supported path.
      </p>
    </div>

    <ol class="mt-12 grid gap-6 md:grid-cols-2">
      {steps.map((step, i) => (
        <li class="card flex min-w-0 flex-col gap-3 p-6">
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-sm font-bold text-accent" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="font-mono text-base font-semibold text-text">{step.title}</h3>
          </div>
          <p class="text-sm leading-relaxed text-muted">{step.body}</p>
          <pre
            class="mt-auto overflow-x-auto rounded-md border border-border bg-bg p-3 font-mono text-xs leading-relaxed text-text"
            tabindex="0"
          ><code>{step.code}</code></pre>
        </li>
      ))}
    </ol>

    <aside class="mt-12 max-w-[70ch] rounded-md border-l-2 border-accent bg-surface p-5">
      <p class="text-sm leading-relaxed text-muted">
        <span class="font-semibold text-text">Still on the source-only path.</span> No package has
        been published from this repository. Clone it, build it, and run it — the full honesty
        breakdown of what works is in{' '}
        <a class="text-accent underline decoration-accent/40 underline-offset-4 hover:text-text" href="#status">
          Status
        </a>
        .
      </p>
    </aside>
  </div>
</section>
