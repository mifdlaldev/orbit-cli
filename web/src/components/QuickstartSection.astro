---
import { site } from '../data/site';

const npmCommand = `npm install -g @mifdlaldev/orbit-cli`;

const steps: readonly { title: string; body: string; code: string }[] = [
  {
    title: 'Install from npm',
    body: 'Pre-alpha — the verified paths are Next.js, Nuxt, Astro and SvelteKit with npm.',
    code: npmCommand,
  },
  {
    title: 'Check your environment',
    body: 'doctor probes 8 tools and exits 0 on the reference machine.',
    code: 'orbit doctor',
  },
  {
    title: 'List the frameworks',
    body: 'Shows all 7 frameworks, grouped by category — matching the CLI registry.',
    code: 'orbit list',
  },
  {
    title: 'Create a project',
    body: 'Scaffolds with the framework\u2019s official create tool, fully non-interactive with flags.',
    code: 'orbit create my-app -t nextjs -p npm -s minimal --yes',
  },
];
---

<section id="quickstart" class="border-t border-border">
  <div class="wrap py-20 md:py-28">
    <div class="max-w-[65ch]">
      <p class="eyebrow">quickstart</p>
      <h2 class="text-h2 mt-3 font-bold text-text">Up and running in four steps</h2>
      <p class="mt-4 text-muted">
        Install from npm. Note the scoped name:{' '}
        <span class="font-mono text-text"> npm install -g orbit-cli</span> (unscoped) would
        install an unrelated package that owns that name —{' '}
        <span class="font-mono text-text">@mifdlaldev/orbit-cli</span> is the one from this
        repository.
      </p>
    </div>

    <ol class="mt-12 grid gap-6 md:grid-cols-2">
      {steps.map((step, i) => (
        <li class="card flex min-w-0 flex-col gap-3 p-6">
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-sm font-bold text-accent" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="font-mono text-base font-semibold text-text">{step.title}</h3>
          </div>
          <p class="text-sm leading-relaxed text-muted">{step.body}</p>
          <pre
            class="mt-auto overflow-x-auto rounded-md border border-border bg-bg p-3 font-mono text-xs leading-relaxed text-text"
            tabindex="0"
          ><code>{step.code}</code></pre>
        </li>
      ))}
    </ol>

    <aside class="mt-12 max-w-[70ch] rounded-md border-l-2 border-accent bg-surface p-5">
      <p class="text-sm leading-relaxed text-muted">
        <span class="font-semibold text-text">Pre-alpha, and honest about it.</span> The four
        npm-verified framework paths run end to end; the rest are declared but unexecuted — the
        full breakdown of what works is in{' '}
        <a class="text-accent underline decoration-accent/40 underline-offset-4 hover:text-text" href="#status">
          Status
        </a>
        . Building from source (clone + <span class="font-mono text-text">npm ci</span> +
        <span class="font-mono text-text">npm run build</span>) still works if you prefer.
      </p>
    </aside>
  </div>
</section>
