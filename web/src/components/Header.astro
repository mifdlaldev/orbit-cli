---
import { site } from '../data/site';

const navLinks = [
  { href: '#features', label: 'Features' },
  { href: '#frameworks', label: 'Frameworks' },
  { href: '#status', label: 'Status' },
  { href: '#quickstart', label: 'Quickstart' },
] as const;
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur-md">
  <div class="wrap flex items-center justify-between gap-4 py-3">
    <a
      href="/"
      class="inline-flex items-center gap-2 font-mono text-base font-bold tracking-tight text-text no-underline hover:text-accent"
      aria-label="ORBIT CLI — home"
    >
      <svg
        aria-hidden="true"
        class="h-4 w-4 text-accent"
        viewBox="0 0 16 16"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M3 4l4 4-4 4"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      {site.name}
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="inline-flex min-h-11 items-center px-3 font-mono text-sm text-muted no-underline transition-colors hover:text-text"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href={site.repoUrl}
      target="_blank"
      rel="noreferrer"
      class="btn btn-ghost text-sm"
      aria-label="ORBIT CLI on GitHub (opens in a new tab)"
    >
      <svg
        aria-hidden="true"
        class="h-4 w-4"
        viewBox="0 0 16 16"
        fill="currentColor"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        />
      </svg>
      GitHub
    </a>
  </div>
</header>
